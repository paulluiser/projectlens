# Required in Vercel for durable shared JSON storage. Connect a private Blob store.
BLOB_READ_WRITE_TOKEN=
# Legacy shared-password sign-in; ignored when Google authentication is configured.
LENS_EDITOR_PASSWORD=

# Optional: Google sign-in replaces shared-password access when Google configuration is present.
# Public OAuth web client ID (not a client secret).
LENS_GOOGLE_CLIENT_ID=
# Comma-separated administrator emails. Administrators manage editors inside Settings.
LENS_ADMIN_EMAILS=
# Optional seed editors; later editor-list changes are saved through Settings to private Blob JSON.
LENS_EDITOR_EMAILS=
# Generate a random secret of at least 32 characters. Keep it server-only and out of Git.
LENS_SESSION_SECRET=
