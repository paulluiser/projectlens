# Live storage selector: blob (legacy) or postgres (after verified migration).
LENS_STORAGE=postgres
# Required for Postgres mode. Use the Neon pooled connection string; keep server-only.
DATABASE_URL=
# Required only for legacy Blob storage / migration backup.
BLOB_READ_WRITE_TOKEN=
# Legacy variable; shared passwords do not authorize production sign-in.
LENS_EDITOR_PASSWORD=

# Google sign-in configuration is required for production accounts.
# Public OAuth web client ID (not a client secret).
LENS_GOOGLE_CLIENT_ID=
# Comma-separated administrator emails. Administrators manage editors inside Settings.
LENS_ADMIN_EMAILS=
# Optional seed editors; later editor-list changes are saved through Settings to private workspace storage.
LENS_EDITOR_EMAILS=
# Generate a random secret of at least 32 characters. Keep it server-only and out of Git.
LENS_SESSION_SECRET=
